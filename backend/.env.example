PORT=8080
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/consentscan
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=you@example.com
# Optional SMTP (Brevo free: smtp-relay.brevo.com, port 587). Without it, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ConsentScan <you@example.com>"
